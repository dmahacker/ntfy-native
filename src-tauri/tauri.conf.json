{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ntfy-native",
  "version": "0.2.0",
  "identifier": "com.ntfy.native",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "ntfy-native",
        "visible": false,
        "skipTaskbar": true,
        "decorations": false,
        "width": 1040,
        "height": 760,
        "minWidth": 960,
        "minHeight": 680
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'self'; form-action 'none'",
      "devCsp": "default-src 'self'; connect-src ipc: http://ipc.localhost http://localhost:1420 ws://localhost:1420; style-src 'self' 'unsafe-inline'; object-src 'none'; base-uri 'self'; form-action 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "publisher": "dmahacker",
    "homepage": "https://github.com/dmahacker/ntfy-native",
    "category": "Utility",
    "shortDescription": "A lightweight ntfy desktop notification client",
    "longDescription": "Subscribe to an ntfy topic with HTTP Basic Auth, receive desktop notifications, and keep listening in the system tray.",
    "windows": {
      "nsis": { "installMode": "currentUser" }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDQ4RkNFNkFDNUNGNDkwREUKUldUZWtQUmNyT2I4U0NLYjJZNzNVaDZoTlJ2eTlJNktudnNXRCt2Syt1cGYvNnlHVHd5aFNjWk4K",
      "endpoints": ["https://github.com/dmahacker/ntfy-native/releases/latest/download/latest.json"]
    }
  }
}
